# Gemini API key — SERVER SIDE ONLY. Never put this in the frontend, never
# commit the real file (.env is gitignored). Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model (gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-4-hydrogen

# Optional: stream canned questions without a key, for UI testing only.
# The frontend badges this as MOCK MODE.
# MOCK_GEMINI=1
