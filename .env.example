# GodsGift — copy to .env
# Get a Gemini API key at https://aistudio.google.com/app/apikey
#
# NOTE: a key in .env is baked into the client bundle at build time, so anyone
# who loads the page can read it. Only use this for local / personal builds.
# For shared deployments, leave this empty and enter the key in Settings
# (stored only in the browser's localStorage).
VITE_GEMINI_API_KEY=
